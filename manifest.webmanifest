{
  "name": "InfoTech.io",
  "short_name": "InfoTech",
  "description": "Plataforma InfoTech.io para sites, sistemas, solicitações, acompanhamento e suporte.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#020611",
  "theme_color": "#020611",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "assets/brand/logo-192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "assets/brand/logo-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    }
  ],
  "id": "/",
  "shortcuts": [
    {
      "name": "Serviços",
      "short_name": "Serviços",
      "url": "/servicos.html",
      "icons": [
        {
          "src": "assets/brand/logo-192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ],
      "description": "Abrir os serviços da InfoTech.io"
    },
    {
      "name": "Projetos",
      "short_name": "Projetos",
      "url": "/projetos.html",
      "icons": [
        {
          "src": "assets/brand/logo-192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ],
      "description": "Ver projetos publicados pela InfoTech.io"
    },
    {
      "name": "Área do Cliente",
      "short_name": "Cliente",
      "url": "/login.html",
      "icons": [
        {
          "src": "assets/brand/logo-192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ],
      "description": "Abrir sua conta e acompanhar solicitações"
    },
    {
      "name": "Nova solicitação",
      "short_name": "Solicitar",
      "url": "/nova-solicitacao.html",
      "icons": [
        {
          "src": "assets/brand/logo-192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ],
      "description": "Criar uma nova solicitação"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "dir": "ltr"
}
