<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.InfoTech" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/infotech_cyan</item>
        <item name="android:statusBarColor">@color/infotech_bg</item>
        <item name="android:navigationBarColor">@color/infotech_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.InfoTech.Splash" parent="Theme.InfoTech">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
